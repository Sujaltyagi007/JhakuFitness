generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model Category {
  id        String    @id
  name      String
  blurb     String
  products  Product[]
}

model Product {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  modelKind      String
  tagline        String
  specialFeature String
  specs          Json
  featured       Boolean   @default(false)
  featureBullets String[]
  imageUrl       String?
  videoUrl       String?
  price          Float?
  colorwayBody   String
  colorwayAccent String
  stock          StockEntry?
  movements      StockMovement[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StockEntry {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int     @default(0)
  minQty    Int     @default(5)
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  qty       Int
  note      String?
  date      DateTime @default(now())
}

// Global Key-Value Settings
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

// Structured Page Content
model ContentBlock {
  slug        String   @id
  title       String?
  bodyText    String?
  mediaUrl    String?
  metadata    Json?
  updatedAt   DateTime @default(now())
}
